<!doctype html>
{%- liquid
  assign locale_code = request.locale.iso_code | default: 'en'
  # Same rule as layout/theme.liquid: compare the language subtag, because
  # `'ar,he,fa,ur' contains 'he-IL'` is false and a substring test leaves every
  # regional right-to-left locale rendering left-to-right.
  assign language = locale_code | split: '-' | first | downcase
  assign rtl_languages = 'ar,he,fa,ur' | split: ','

  assign text_direction = 'ltr'
  if rtl_languages contains language
    assign text_direction = 'rtl'
  endif
-%}
<html lang="{{ locale_code }}" dir="{{ text_direction }}" class="no-js">
  <head>
    {%- render 'meta-tags' -%}

    <link rel="icon" type="image/svg+xml" href="{{ 'logomark.svg' | asset_url }}">

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {{ 'commerce.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.classList.replace('no-js', 'js');</script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
