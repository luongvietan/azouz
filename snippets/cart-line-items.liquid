{%- comment -%}
  The cart's line list. Shared by the cart page and the drawer.

  Accepts: cart (required), form_id (optional, associates the quantity inputs
  with a form that lives outside this markup)

  Renders nothing for an empty cart — the caller shows the empty state.
{%- endcomment -%}

{%- if cart.items.size > 0 -%}
  <ul class="cart-lines" role="list">
    {%- for item in cart.items -%}
      {%- assign product_title = item.product.title | default: item.title -%}
      {%- assign variant_title = item.variant.title -%}
      {%- assign line_image = item.image | default: item.variant.image | default: item.product.featured_image -%}
      <li class="cart-line" data-line-key="{{ item.key | escape }}" data-variant-id="{{ item.variant_id | default: item.variant.id | escape }}">
        {%- if line_image -%}
          {%- render 'responsive-image',
            image: line_image,
            alt: product_title,
            class: 'cart-line__image',
            width: 160,
            sizes: '80px'
          -%}
        {%- endif -%}

        <div class="cart-line__info">
          <a class="cart-line__title" href="{{ item.url }}">{{ product_title | escape }}</a>
          {%- if variant_title != blank and variant_title != 'Default Title' -%}
            <p class="cart-line__variant">{{ variant_title | escape }}</p>
          {%- endif -%}
          <p class="cart-line__unit">{{ item.price | money }}</p>
        </div>

        <div class="cart-line__actions">
          {%- assign quantity_name = 'updates[' | append: item.key | append: ']' -%}
          {%- render 'quantity-input',
            name: quantity_name,
            value: item.quantity,
            min: 0,
            form: form_id
          -%}

          <a
            class="cart-line__remove"
            href="{{ routes.cart_change_url }}?id={{ item.key | url_encode }}&amp;quantity=0">
            {%- render 'icon', name: 'remove' -%}
            <span class="visually-hidden">
              {{- 'cart.general.remove_item' | t: title: product_title | escape -}}
            </span>
          </a>
        </div>

        <p class="cart-line__total">
          <span class="visually-hidden">{{ 'cart.general.line_total' | t }}</span>
          {{ item.line_price | money }}
        </p>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
