{%- comment -%}
  Product tile built from the packaging label block.

  Accepts:
    product        - required
    heading_level  - optional, 2 or 3 (default 3)

  The card title has to sit one level below whatever heading introduces the
  grid. Under a section h2 — featured-collection — that is h3. On a collection
  or search page the grid follows the h1 directly, so it is h2.

  Every metafield read is guarded — the card is correct on a store where the
  definitions have not been created yet.
{%- endcomment -%}

{%- liquid
  assign custom = product.metafields.custom
  assign notes = custom.tasting_notes.value
  assign label_color = custom.label_color.value
  assign origin = custom.origin.value
  assign process = custom.process.value

  assign ranged = false
  if product.price_min != product.price_max
    assign ranged = true
  endif
-%}

<article class="product-card">
  {%- if product.featured_image -%}
    {%- render 'responsive-image',
      image: product.featured_image,
      alt: product.title,
      class: 'product-card__image',
      width: 600,
      sizes: '(min-width: 56em) 30vw, (min-width: 48em) 45vw, 90vw'
    -%}
  {%- endif -%}

  {%- unless product.available -%}
    <p class="product-card__badge">{{ 'products.product.sold_out' | t }}</p>
  {%- endunless -%}

  <div class="label-block product-card__label"{% if label_color != blank %} style="{% render 'label-ink', color: label_color %}"{% endif %}>
    {%- assign heading_tag = 'h3' -%}
    {%- if heading_level == 2 -%}{%- assign heading_tag = 'h2' -%}{%- endif -%}
    <{{ heading_tag }} class="label-block__title">
      <a class="product-card__link" href="{{ product.url }}">{{ product.title }}</a>
    </{{ heading_tag }}>
    {%- if notes != blank -%}
      <p class="label-block__subtitle">{{ notes | join: ' | ' }}</p>
    {%- endif -%}
  </div>

  <div class="product-card__meta">
    {%- render 'price',
      price: product.price,
      compare_at: product.compare_at_price,
      show_from: ranged
    -%}
  </div>

  {%- comment -%}
    The spec rows, read straight off the bag: term on one line, value under it,
    each pair divided by a rule. A <dl> rather than a table — these are name and
    value, not a grid of data — and every row is guarded, so a store that has
    only filled in some of the definitions gets a shorter list, not empty rows.
  {%- endcomment -%}
  {%- capture specs -%}
    {%- if notes != blank -%}
      <div class="product-card__spec">
        <dt class="product-card__spec-term">{{ 'products.product.tasting_notes' | t }}</dt>
        <dd class="product-card__spec-value">{{ notes | join: ', ' }}</dd>
      </div>
    {%- endif -%}
    {%- if process != blank -%}
      <div class="product-card__spec">
        <dt class="product-card__spec-term">{{ 'products.product.process' | t }}</dt>
        <dd class="product-card__spec-value">{{ process }}</dd>
      </div>
    {%- endif -%}
    {%- if origin != blank -%}
      <div class="product-card__spec">
        <dt class="product-card__spec-term">{{ 'products.product.origin' | t }}</dt>
        <dd class="product-card__spec-value">{{ origin }}</dd>
      </div>
    {%- endif -%}
    {%- if custom.roast_level.value != blank -%}
      <div class="product-card__spec">
        <dt class="product-card__spec-term">{{ 'products.product.roast_level' | t }}</dt>
        <dd class="product-card__spec-value">
          {%- render 'roast-meter', level: custom.roast_level.value -%}
        </dd>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- if specs != blank -%}
    <dl class="product-card__specs">{{ specs }}</dl>
  {%- endif -%}
</article>
