<section class="section main-collection"{{ section.shopify_attributes }}>
  <div class="container">
    <header class="collection__head">
      <h1 class="collection__heading">{{ collection.title }}</h1>

      {%- if collection.description != blank -%}
        <div class="collection__description rte">{{ collection.description }}</div>
      {%- endif -%}

      <p class="collection__count">
        {{ 'collections.general.product_count' | t: count: collection.products_count }}
      </p>
    </header>

    {%- comment -%}
      A GET form, so a sorted collection is a URL the customer can share, and so
      it works with scripting off — the Apply button submits it. With JS on the
      button is hidden and the select submits on change.
    {%- endcomment -%}
    {%- if collection.sort_options.size > 1 -%}
      {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
      <form class="collection__sort" method="get">
        <div class="field field--inline">
          <label class="field__label" for="CollectionSort">{{ 'collections.general.sort_by' | t }}</label>
          <select class="field__input" id="CollectionSort" name="sort_by" data-collection-sort>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>
                {{- option.name -}}
              </option>
            {%- endfor -%}
          </select>
        </div>
        <button class="button button--secondary collection__sort-apply" type="submit">
          {{ 'collections.general.sort_apply' | t }}
        </button>
      </form>
    {%- endif -%}

    {%- if collection.products.size == 0 -%}
      <p class="collection__empty">{{ 'collections.general.no_products' | t }}</p>
    {%- else -%}
      {%- paginate collection.products by 12 -%}
        <reveal-on-scroll>
          <div class="grid grid--3 collection__grid">
            {%- for product in collection.products -%}
              <div class="reveal">
                {%- render 'product-card', product: product, heading_level: 2 -%}
              </div>
            {%- endfor -%}
          </div>
        </reveal-on-scroll>

        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "settings": []
}
{% endschema %}
