<!doctype html>
{%- liquid
  assign locale_code = request.locale.iso_code | default: 'en'
  assign rtl_locales = 'ar,he,fa,ur'
  assign text_direction = 'ltr'
  if rtl_locales contains locale_code
    assign text_direction = 'rtl'
  endif
-%}
<html lang="{{ locale_code }}" dir="{{ text_direction }}" class="no-js">
  <head>
    {%- render 'meta-tags' -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="icon" type="image/svg+xml" href="{{ 'logomark.svg' | asset_url }}">

    {%- comment -%}
      Only the regular-weight Latin face is preloaded. It carries the body copy
      and is needed for first paint; the other faces load on demand via swap.
    {%- endcomment -%}
    <link rel="preload" href="{{ 'baloo-latin-400.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {{ 'commerce.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Theme-editor colour overrides.

      tokens.css owns the guideline palette and the measured contrast contract
      documented at the top of that file. This block only emits a property the
      merchant has actually set, so an unconfigured store renders the brand
      palette verbatim and the contract still holds. A merchant who overrides
      these owns the resulting ratios — the schema says so.

      It comes after every stylesheet, so these definitions win on :root.
    {%- endcomment -%}
    {%- capture color_overrides -%}
      {%- if settings.color_background != blank %}--color-bg: {{ settings.color_background }};{% endif -%}
      {%- if settings.color_background_alt != blank %}--color-bg-alt: {{ settings.color_background_alt }};{% endif -%}
      {%- if settings.color_text != blank %}--color-text: {{ settings.color_text }};{% endif -%}
      {%- if settings.color_accent != blank %}--color-accent: {{ settings.color_accent }};{% endif -%}
      {%- comment -%} The focus ring shares the deep accent so it can never lose contrast against it. {%- endcomment -%}
      {%- assign deep = settings.color_accent_deep -%}
      {%- if deep != blank %}--color-accent-deep: {{ deep }};--color-focus: {{ deep }};{% endif -%}
    {%- endcapture -%}
    {%- if color_overrides != blank -%}
      <style>:root{ {{- color_overrides -}} }</style>
    {%- endif -%}

    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {%- render 'structured-data' -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | default: 'index' }}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% section 'cart-drawer' %}
  </body>
</html>
