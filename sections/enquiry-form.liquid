{%- liquid
  assign section_class = 'section enquiry'
  if section.settings.background == 'alt'
    assign section_class = 'section section--alt enquiry'
  endif
  assign uid = section.id
-%}

<section class="{{ section_class }}"{{ section.shopify_attributes }}>
  <div class="container container--narrow enquiry__inner">
    <div class="enquiry__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="enquiry__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <div class="enquiry__intro lead">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    {% form 'contact' %}
      <div aria-live="polite">
        {%- if form.posted_successfully? -%}
          <p class="enquiry__success" role="status">{{ 'contact.form.success' | t }}</p>
        {%- endif -%}

        {%- comment -%}
          A named list, not a bare "check the highlighted fields" — nothing was
          highlighted. The summary is focusable so the browser can land on it via
          the #contact fragment Shopify redirects to after a rejected post.
        {%- endcomment -%}
        {%- if form.errors -%}
          <div class="enquiry__error" role="alert" tabindex="-1" id="EnquiryErrors-{{ uid }}">
            <p class="enquiry__error-lead">{{ 'contact.form.error' | t }}</p>
            <ul class="enquiry__error-list" role="list">
              {%- for field in form.errors -%}
                <li>
                  {{- form.errors.translated_fields[field] | default: field | capitalize }}:
                  {{ form.errors.messages[field] -}}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      <div class="enquiry__groups">
        <fieldset class="enquiry__group">
          <legend class="enquiry__legend">{{ 'contact.form.contact_group' | t }}</legend>
          <div class="enquiry__grid">
            <div class="field">
              <label class="field__label" for="EnquiryName-{{ uid }}">{{ 'contact.form.name' | t }}</label>
              <input class="field__input" type="text" id="EnquiryName-{{ uid }}" name="contact[name]" autocomplete="name"{% if form.errors contains 'name' %} aria-invalid="true"{% endif %} required>
            </div>

            <div class="field">
              <label class="field__label" for="EnquiryCompany-{{ uid }}">{{ 'contact.form.company' | t }}</label>
              <input class="field__input" type="text" id="EnquiryCompany-{{ uid }}" name="contact[Company]" autocomplete="organization">
            </div>

            <div class="field">
              <label class="field__label" for="EnquiryEmail-{{ uid }}">{{ 'contact.form.email' | t }}</label>
              <input class="field__input" type="email" id="EnquiryEmail-{{ uid }}" name="contact[email]" autocomplete="email"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %} required>
            </div>

            <div class="field">
              <label class="field__label" for="EnquiryPhone-{{ uid }}">{{ 'contact.form.phone' | t }}</label>
              <input class="field__input" type="tel" id="EnquiryPhone-{{ uid }}" name="contact[phone]" autocomplete="tel">
            </div>
          </div>
        </fieldset>

        <fieldset class="enquiry__group">
          <legend class="enquiry__legend">{{ 'contact.form.project_group' | t }}</legend>
          <div class="enquiry__grid">
            <div class="field">
              <label class="field__label" for="EnquiryBusiness-{{ uid }}">{{ 'contact.form.business_type' | t }}</label>
              <select class="field__input" id="EnquiryBusiness-{{ uid }}" name="contact[Business type]">
                <option value="">{{ 'contact.form.business_type_prompt' | t }}</option>
                {%- comment -%}
                  `split: ','` keeps the leading space on every entry after the
                  first, so compare against the stripped name — not the raw one,
                  which would only ever match the first business type.
                {%- endcomment -%}
                {%- assign business_types = section.settings.business_types | split: ',' -%}
                {%- for type in business_types -%}
                  {%- assign type_name = type | strip -%}
                  <option value="{{ type_name | escape }}"{% if section.settings.preselect_business == type_name %} selected{% endif %}>{{ type_name }}</option>
                {%- endfor -%}
              </select>
            </div>

            <div class="field">
              <label class="field__label" for="EnquiryCoffee-{{ uid }}">{{ 'contact.form.coffee_type' | t }}</label>
              <select class="field__input" id="EnquiryCoffee-{{ uid }}" name="contact[Coffee type]">
                <option value="">{{ 'contact.form.coffee_type_prompt' | t }}</option>
                {%- assign coffee_types = section.settings.coffee_types | split: ',' -%}
                {%- for type in coffee_types -%}
                  <option value="{{ type | strip | escape }}">{{ type | strip }}</option>
                {%- endfor -%}
              </select>
            </div>

            <div class="field field--wide">
              <label class="field__label" for="EnquiryVolume-{{ uid }}">
                {{ 'contact.form.volume' | t }}
                {%- unless section.settings.require_volume %} <span class="field__hint">({{ 'contact.form.optional' | t }})</span>{% endunless -%}
              </label>
              <input
                class="field__input"
                type="text"
                id="EnquiryVolume-{{ uid }}"
                name="contact[Expected monthly volume]"
                placeholder="{{ 'contact.form.volume_placeholder' | t }}"
                aria-describedby="EnquiryVolumeHint-{{ uid }}"
                {% if section.settings.require_volume %}required{% endif %}>
              <p class="field__hint" id="EnquiryVolumeHint-{{ uid }}">{{ 'contact.form.volume_hint' | t }}</p>
            </div>

            <div class="field field--wide">
              <label class="field__label" for="EnquiryMessage-{{ uid }}">{{ 'contact.form.message' | t }}</label>
              <textarea
                class="field__input field__input--textarea"
                id="EnquiryMessage-{{ uid }}"
                name="contact[body]"
                rows="5"
                aria-describedby="EnquiryMessageHint-{{ uid }}"
                {% if form.errors contains 'body' %}aria-invalid="true" {% endif %}
                placeholder="{{ 'contact.form.message_placeholder' | t }}"></textarea>
              <p class="field__hint" id="EnquiryMessageHint-{{ uid }}">{{ 'contact.form.message_hint' | t }}</p>
            </div>
          </div>
        </fieldset>
      </div>

      {%- comment -%}
        Honeypot. Bots fill every field they find; a person never sees this one.
        aria-hidden and tabindex="-1" keep it away from screen readers and the
        keyboard, so it costs a real customer nothing. Shopify has no server-side
        hook to reject on, but the value arrives in the notification email and
        makes a submission trivially filterable.
      {%- endcomment -%}
      <div class="enquiry__honeypot" aria-hidden="true">
        <label for="EnquiryWebsite-{{ uid }}">{{ 'contact.form.honeypot' | t }}</label>
        <input
          type="text"
          id="EnquiryWebsite-{{ uid }}"
          name="contact[Website]"
          tabindex="-1"
          autocomplete="off">
      </div>

      <button class="button enquiry__submit" type="submit">{{ 'contact.form.send' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Enquiry form",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Request a Sample" },
    { "type": "richtext", "id": "body", "label": "Intro" },
    {
      "type": "textarea",
      "id": "business_types",
      "label": "Business types",
      "default": "Coffee Shop, Restaurant, Hotel, Office, Retailer, Distributor, Startup, Supermarket, Other",
      "info": "Comma separated."
    },
    { "type": "text", "id": "preselect_business", "label": "Pre-selected business type" },
    {
      "type": "textarea",
      "id": "coffee_types",
      "label": "Coffee types",
      "default": "Espresso, Turkish, Arabic, Specialty, Single origin, Filter, Whole bean, Ground, Not sure yet",
      "info": "Comma separated."
    },
    { "type": "checkbox", "id": "require_volume", "label": "Require expected volume", "default": false },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page" },
        { "value": "alt", "label": "Warm cream" }
      ],
      "default": "alt"
    }
  ],
  "presets": [
    {
      "name": "Request a sample",
      "settings": { "heading": "Request a Sample", "require_volume": false }
    },
    {
      "name": "Get a quote",
      "settings": { "heading": "Get a Quote", "require_volume": true }
    }
  ]
}
{% endschema %}
