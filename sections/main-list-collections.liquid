<section class="section main-list-collections"{{ section.shopify_attributes }}>
  <div class="container container--ultra">
    <div class="section-head">
      <h1 class="list-collections__heading section-head__heading section-head__heading--large">
        {{- 'collections.general.title' | t -}}
      </h1>
      <hr class="section-head__rule">
    </div>

    {%- if collections.size == 0 -%}
      <p class="collection__empty">{{ 'collections.general.empty' | t }}</p>
    {%- else -%}
      <ul class="list-lines list-lines--3 list-collections__grid" role="list">
        {%- for item in collections -%}
          <li class="collection-card">
            {%- if item.image -%}
              {%- render 'responsive-image',
                image: item.image,
                alt: item.title,
                class: 'collection-card__image',
                width: 600,
                sizes: '(min-width: 56em) 30vw, (min-width: 48em) 45vw, 90vw'
              -%}
            {%- endif -%}
            <h2 class="collection-card__title">
              <a href="{{ item.url }}">{{ item.title }}</a>
            </h2>
            <p class="collection-card__count">
              {{ 'collections.general.product_count' | t: count: item.products_count }}
            </p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "settings": []
}
{% endschema %}
