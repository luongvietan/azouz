{%- comment -%}
  Search results.

  Predictive search is a Shopify server-side API with no local equivalent and
  is out of scope; this is a plain GET form, which means a search is a URL the
  customer can bookmark and share.
{%- endcomment -%}

<section class="section main-search"{{ section.shopify_attributes }}>
  <div class="container container--narrow main-search__inner">
    <h1 class="search__heading">{{ 'general.search.title' | t }}</h1>

    <form class="search__form" method="get" action="{{ routes.search_url }}" role="search">
      {%- comment -%}
        Restrict the search to products. Left open, Shopify also returns pages
        and articles, which have no price, image or variants — product-card
        would render them as empty tiles.
      {%- endcomment -%}
      <input type="hidden" name="type" value="product">

      <div class="field">
        <label class="field__label" for="SearchInput">{{ 'general.search.title' | t }}</label>
        <input
          class="field__input"
          type="search"
          id="SearchInput"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t | escape }}">
      </div>
      <button class="button" type="submit">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="search__count">
          {{ 'general.search.results_count' | t: count: search.results_count }}
        </p>
      {%- else -%}
        <p class="search__empty">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      A search box on its own is a question with no hint of what can be asked.
      This is the way out for both readers who need one: the visitor who has
      not searched yet and has nothing to look at, and the one whose search
      found nothing. It is suppressed only on a page that already has results
      to read.
    {%- endcomment -%}
    {%- unless search.performed and search.results_count > 0 -%}
      <p class="search__browse">
        <a class="anchor-arrow" href="{{ routes.all_products_collection_url }}">
          {{ 'general.search.browse_all' | t }}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      </p>
    {%- endunless -%}
  </div>

  {%- if search.results_count > 0 -%}
    <div class="container container--ultra">
      {%- paginate search.results by 12 -%}
        <ul class="list-lines list-lines--4 search__grid" role="list">
          {%- comment -%}
            The hidden type field above keeps this to products, but a hand-typed
            ?type=article would still reach here — so only products become cards.
          {%- endcomment -%}
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <li>{%- render 'product-card', product: item, heading_level: 2 -%}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "tag": "div",
  "settings": []
}
{% endschema %}
