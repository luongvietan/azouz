{%- comment -%}
  The one full-bleed statement on the page: a photograph, a scrim, and a stack
  of centred copy over it — eyebrow, headline, a supporting line and the two
  ways on.

  Without a photograph it paints Coffee Brown instead of the green — a template
  that ends on the green CTA band would otherwise carry two green bands, and
  brown holds the same white copy at 11.9:1.
{%- endcomment -%}
{%- liquid
  assign has_primary = false
  if section.settings.cta_primary_label != blank and section.settings.cta_primary_link != blank
    assign has_primary = true
  endif

  assign has_secondary = false
  if section.settings.cta_secondary_label != blank and section.settings.cta_secondary_link != blank
    assign has_secondary = true
  endif

  assign band_class = 'feature-band feature-band--solid'
  if section.settings.image
    assign band_class = 'feature-band feature-band--media'
  endif
-%}

<div class="{{ band_class }}"{{ section.shopify_attributes }}>
  {%- if section.settings.image -%}
    {%- render 'responsive-image',
      image: section.settings.image,
      alt: section.settings.image_alt,
      class: 'feature-band__image',
      width: 2000,
      sizes: '100vw'
    -%}
    <div class="feature-band__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="container container--ultra feature-band__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow feature-band__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h2 class="feature-band__heading">{{ section.settings.heading }}</h2>

    {%- if section.settings.subheading != blank -%}
      <p class="feature-band__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="feature-band__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if has_primary or has_secondary -%}
      <div class="feature-band__actions">
        {%- if has_primary -%}
          <a class="anchor-arrow feature-band__link" href="{{ section.settings.cta_primary_link }}">
            {{ section.settings.cta_primary_label }}
            {%- render 'icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
        {%- if has_secondary -%}
          <a class="anchor-arrow feature-band__link" href="{{ section.settings.cta_secondary_link }}">
            {{ section.settings.cta_secondary_label }}
            {%- render 'icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The sample box" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_primary_label", "label": "First link label" },
    { "type": "url", "id": "cta_primary_link", "label": "First link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Second link label" },
    { "type": "url", "id": "cta_secondary_link", "label": "Second link" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Landscape, at least 2000px wide. Leave empty to paint the band in Coffee Brown instead."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "info": "Describe the image for screen readers and for when it fails to load."
    }
  ],
  "presets": [{ "name": "Feature band" }]
}
{% endschema %}
