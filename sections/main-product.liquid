{%- liquid
  assign current = product.selected_or_first_available_variant
  assign custom = product.metafields.custom
  assign notes = custom.tasting_notes.value
  assign brews = custom.brew_methods.value
  assign label_color = custom.label_color.value

  # Roast level is one of the label's rows now, so it has to count towards
  # whether there is a label to draw at all — a store that has filled in only
  # the roast level would otherwise lose the meter along with the list. A flat
  # chain of `or` is safe here where a mixed `and`/`or` would not be.
  assign has_specs = false
  if custom.origin.value != blank or custom.process.value != blank or custom.altitude.value != blank or custom.roast_level.value != blank
    assign has_specs = true
  endif

  assign add_label = 'products.product.add_to_cart' | t
  assign sold_out_label = 'products.product.sold_out' | t
-%}

<section class="section main-product" data-product-root{{ section.shopify_attributes }}>
  <div class="container container--ultra">
    <nav class="breadcrumb" aria-label="{{ 'general.accessibility.breadcrumb' | t }}">
      <ol class="breadcrumb__list" role="list">
        <li class="breadcrumb__item">
          <a class="breadcrumb__link" href="{{ routes.root_url }}">{{ 'general.meta.home' | t }}</a>
        </li>
        <li class="breadcrumb__item">
          <a class="breadcrumb__link" href="{{ collection.url | default: routes.all_products_collection_url }}">{{ 'general.meta.shop' | t }}</a>
        </li>
        <li class="breadcrumb__item">
          <span class="breadcrumb__current" aria-current="page">{{ product.title }}</span>
        </li>
      </ol>
    </nav>

    <div class="main-product__inner">
      <div class="main-product__media">
      {%- comment -%}
        The whole gallery, not just the featured shot — the packaging is the
        product here, and a merchant who uploads a second angle expects it to
        appear. The first image leads at full width and is the LCP element; the
        rest sit beside it as a rail and lazy-load.

        The rail is not a scripted carousel. Every angle is on the page and in
        the document order a screen reader walks, so there is nothing to upgrade
        and nothing that breaks when the runtime does not load.
      {%- endcomment -%}
      {%- for image in product.images -%}
        {%- liquid
          assign image_loading = 'lazy'
          assign image_priority = ''
          assign image_class = 'main-product__image main-product__image--thumb'
          assign image_sizes = '(min-width: 56em) 11vw, 28vw'
          if forloop.first
            assign image_loading = 'eager'
            assign image_priority = 'high'
            assign image_class = 'main-product__image main-product__image--lead'
            assign image_sizes = '(min-width: 56em) 45vw, 92vw'
          endif

          assign image_alt = image.alt | default: product.title
        -%}
        {%- render 'responsive-image',
          image: image,
          alt: image_alt,
          class: image_class,
          width: 1200,
          sizes: image_sizes,
          loading: image_loading,
          fetchpriority: image_priority
        -%}
      {%- endfor -%}
      </div>

      <div class="main-product__details">
      <div class="label-block main-product__label"{% if label_color != blank %} style="{% render 'label-ink', color: label_color %}"{% endif %}>
        <h1 class="label-block__title">{{ product.title }}</h1>
        {%- if notes != blank -%}
          <p class="label-block__subtitle">{{ notes | join: ' | ' }}</p>
        {%- endif -%}

        {%- if has_specs -%}
          <hr class="label-block__rule">
          <dl class="label-block__specs">
            {%- if custom.origin.value != blank -%}
              <div><dt>{{ 'products.product.origin' | t }}</dt><dd>{{ custom.origin.value }}</dd></div>
            {%- endif -%}
            {%- if custom.process.value != blank -%}
              <div><dt>{{ 'products.product.process' | t }}</dt><dd>{{ custom.process.value }}</dd></div>
            {%- endif -%}
            {%- if custom.altitude.value != blank -%}
              <div><dt>{{ 'products.product.altitude' | t }}</dt><dd>{{ custom.altitude.value }}</dd></div>
            {%- endif -%}
            {%- comment -%}
              Roast level belongs in the label with the rest of it. The bag
              prints it there — the dots sit beside "whole bean, 100% arabica"
              on the real thing — and standing it outside as its own row cost
              72px between the label and the price, on a column that was
              already pushing "Add to cart" below the fold.
            {%- endcomment -%}
            {%- if custom.roast_level.value != blank -%}
              <div>
                <dt>{{ 'products.product.roast_level' | t }}</dt>
                <dd>{%- render 'roast-meter', level: custom.roast_level.value -%}</dd>
              </div>
            {%- endif -%}
          </dl>
        {%- endif -%}
      </div>

      {%- comment -%}
        A live region: <variant-picker> rewrites this when the selection
        changes, and without it the new price is a silent update.
      {%- endcomment -%}
      <p class="main-product__price" data-product-price aria-live="polite">
        {%- render 'price', price: current.price, compare_at: current.compare_at_price -%}
      </p>

      {%- form 'product', product, id: 'AddToCart', class: 'main-product__form' -%}
        {%- comment -%}
          Every bag in the range ships in one size and one grind, so most
          products have a single variant. A picker there is two selects the
          customer cannot change — and <variant-picker> is what writes the
          hidden name="id" input, so the field has to be written here instead
          or the form posts without a variant.
        {%- endcomment -%}
        {%- if product.variants.size > 1 -%}
          {%- render 'variant-picker', product: product, form_id: 'AddToCart' -%}
        {%- else -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- endif -%}

        <div class="main-product__purchase">
          {%- render 'quantity-input', name: 'quantity', value: 1, min: 1, form: 'AddToCart' -%}

          <product-form class="main-product__submit">
            <button
              class="button main-product__add"
              type="submit"
              data-add-to-cart
              data-label-add="{{ add_label | escape }}"
              data-label-sold-out="{{ sold_out_label | escape }}"
              {% unless current.available %}disabled{% endunless %}>
              {%- if current.available -%}{{ add_label }}{%- else -%}{{ sold_out_label }}{%- endif -%}
            </button>
          </product-form>
        </div>
      {%- endform -%}

      {%- if product.description != blank -%}
        <details class="accordion" open>
          <summary class="accordion__summary">{{ 'products.product.description' | t }}</summary>
          <div class="accordion__body rte">{{ product.description }}</div>
        </details>
      {%- endif -%}

      {%- if brews != blank -%}
        <details class="accordion">
          <summary class="accordion__summary">{{ 'products.product.brewing' | t }}</summary>
          <div class="accordion__body">
            <ul class="main-product__brews" role="list">
              {%- for method in brews -%}
                <li>{{ method }}</li>
              {%- endfor -%}
            </ul>
          </div>
        </details>
      {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "settings": []
}
{% endschema %}
