<section id="factory-media" class="section factory-media" aria-labelledby="FactoryMedia-{{ section.id }}">
  <div class="container container--ultra">
    <div class="factory-media__intro">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 id="FactoryMedia-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <div class="factory-media__copy rte">{{ section.settings.body }}</div>
    </div>
    <div class="factory-media__process" aria-labelledby="FactoryProcess-{{ section.id }}">
      <h3 id="FactoryProcess-{{ section.id }}">{{ 'retail.factory.process_title' | t }}</h3>
      <ol>
        <li>{{ 'retail.factory.step_1' | t }}</li>
        <li>{{ 'retail.factory.step_2' | t }}</li>
        <li>{{ 'retail.factory.step_3' | t }}</li>
        <li>{{ 'retail.factory.step_4' | t }}</li>
      </ol>
    </div>
    <div class="factory-media__feature">
      <video class="factory-media__video" controls playsinline preload="metadata" poster="{{ 'factory-montage-poster.jpg' | asset_url }}" aria-label="{{ section.settings.montage_title }}">
        <source src="{{ 'factory-montage.mp4' | asset_url }}" type="video/mp4">
      </video>
      <div class="factory-media__feature-copy">
        <h3>{{ section.settings.montage_title }}</h3>
        <p>{{ section.settings.montage_caption }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Factory media",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the roastery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our factory" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>A look at the people, equipment and small moments behind every Azouz Coffee bag.</p>" },
    { "type": "text", "id": "montage_title", "label": "Montage title", "default": "A short look inside the roastery" },
    { "type": "textarea", "id": "montage_caption", "label": "Montage caption", "default": "A sequence from green beans to the roasted coffee ready for packing." }
  ],
  "presets": [{ "name": "Factory media" }]
}
{% endschema %}
