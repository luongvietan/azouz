{%- comment -%}
  A heading and the argument under it, set side by side on a wide screen: the
  heading holds the inline-start column and the copy reads down the other, so
  four or five short lines keep a measure a reader can follow instead of
  running the width of the container.

  A list in the copy is drawn as a rule-divided index rather than as bullets.
  Each line of it is a point the reader should be able to find again, and the
  strokes are the same ones that divide every other index on the site.

  The closing line is where those points land, so it comes after them and is
  set larger. It is optional: an argument that ends on its last paragraph needs
  no line of its own.
{%- endcomment -%}
{%- liquid
  assign section_class = 'section rich-text'
  if section.settings.background == 'alt'
    assign section_class = 'section section--alt rich-text'
  endif
-%}

<section class="{{ section_class }}"{{ section.shopify_attributes }}>
  <div class="container rich-text__inner">
    <div class="rich-text__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="rich-text__content">
      {%- if section.settings.body != blank -%}
        <div class="rich-text__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.closing != blank -%}
        <p class="rich-text__closing">{{ section.settings.closing }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Coffee Business Without Starting From Zero." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Paragraphs, or a bulleted list. A list is drawn as a ruled index, one point to a line."
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "Closing line",
      "info": "Optional. Set larger, after the body: the conclusion the points above it lead to."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page" },
        { "value": "alt", "label": "Warm cream" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "settings": {
        "heading": "A Coffee Business Without Starting From Zero.",
        "body": "<p>Opening a coffee shop involves more than finding a location.</p>"
      }
    }
  ]
}
{% endschema %}
