{%- comment -%}
  Four ways into the range. On the homepage the first entry leads with a
  larger photograph and copy alongside; the remaining entries share a row.

  The whole cell is not a link — the heading and the trailing link point at the
  same place, and duplicating a target across a block-level anchor makes the
  block unreadable to a screen reader that lists links. One anchor per entry.
{%- endcomment -%}
{%- liquid
  assign section_class = 'section quick-links'
  if section.settings.background == 'alt'
    assign section_class = 'section section--alt quick-links'
  endif

  assign has_link = false
  if section.settings.link_label != blank and section.settings.link != blank
    assign has_link = true
  endif
-%}

<div class="{{ section_class }}"{{ section.shopify_attributes }}>
  <div class="container container--ultra">
    <div class="section-head">
      <h2 class="section-head__heading">{{ section.settings.heading }}</h2>
      {%- if has_link -%}
        <a class="anchor-arrow section-head__link" href="{{ section.settings.link }}">
          {{ section.settings.link_label }}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
      <hr class="section-head__rule">
    </div>

    <ul class="list-lines list-lines--4 quick-links__list" role="list">
      {%- for block in section.blocks -%}
        <li class="quick-links__item"{{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <div class="quick-links__media">
              {%- liquid
                assign image_sizes = '(min-width: 64em) 24vw, (min-width: 40em) 46vw, 92vw'
                if request.page_type == 'index'
                  assign image_sizes = '(min-width: 56em) 31vw, (min-width: 40em) 46vw, 92vw'
                  if forloop.first
                    assign image_sizes = '(min-width: 56em) 58vw, 92vw'
                  endif
                endif
              -%}
              {%- render 'responsive-image', image: block.settings.image, alt: block.settings.image_alt, class: 'quick-links__image', width: 1600, sizes: image_sizes -%}
            </div>
          {%- endif -%}
          <div class="quick-links__content">
          <h3 class="quick-links__title">{{ block.settings.title }}</h3>
          {%- if block.settings.body != blank -%}
            <p class="quick-links__body">{{ block.settings.body }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="anchor-arrow quick-links__link" href="{{ block.settings.link }}">
              {{ block.settings.link_label }}
              {%- render 'icon', name: 'arrow-right' -%}
            </a>
          {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Quick links",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we do" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page" },
        { "value": "alt", "label": "Warm cream" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Entry",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photograph" },
        { "type": "text", "id": "image_alt", "label": "Photograph description" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "body", "label": "Body" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Quick links" }]
}
{% endschema %}
